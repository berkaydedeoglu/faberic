# HTTP server
PORT=6565
HOST=0.0.0.0

# Pi SDK
PI_AGENT_DIR=/tmp/faberic-agent-base
PI_AUTH_PATH=/tmp/faberic-agent-base/auth.json
PI_MODELS_PATH=/tmp/faberic-agent-base/models.json
# Where sessions are persisted. Empty = pi default (~/.pi/agent/sessions/<cwd>/), shared with the pi CLI.
PI_SESSION_DIR=

# Default model selection (provider id + model id, per @earendil-works/pi-ai catalog)
PI_DEFAULT_PROVIDER=anthropic
PI_DEFAULT_MODEL=claude-sonnet-4-5
PI_DEFAULT_THINKING_LEVEL=medium

# Provider credentials (only the ones you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Orchestrator API that receives agent events (POST, Bearer token)
ORCHESTRATOR_API_URL=
ORCHESTRATOR_API_TOKEN=
